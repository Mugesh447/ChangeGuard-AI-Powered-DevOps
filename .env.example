# Frontend
VITE_API_BASE_URL=http://localhost:4000/api

# API server
API_PORT=4000
DATABASE_PATH=data/changeguard.db
DATABASE_URL=postgresql://changeguard:password@localhost:5432/changeguard
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Optional real AI provider
# OPENAI_API_KEY=your-key
OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# Azure Key Vault via managed identity / DefaultAzureCredential
# AZURE_KEY_VAULT_URL=https://your-key-vault.vault.azure.net/

# Optional MCP HTTP server
# MCP_SERVER_URL=http://localhost:8787/mcp
# MCP_SERVER_TOKEN=your-token

# Optional AWS credentials/profile
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/ChangeGuardReadOnly

# Notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=notifications@example.com
# NOTIFICATION_EMAIL=ops@example.com
